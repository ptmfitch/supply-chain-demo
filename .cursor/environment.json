{
  "name": "Stockly (Next.js 16 + Prisma + MongoDB)",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "dev",
      "command": "bash .cursor/start.sh --wait && npm run dev",
      "description": "Next.js dev server (Turbopack) on http://localhost:3000 — waits for start.sh (MongoDB + seed)"
    }
  ],
  "ports": [
    { "name": "web", "port": 3000 },
    { "name": "mongodb", "port": 27017 }
  ]
}
