{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/ensure-logging.cjs",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/ensure-logging.cjs",
        "timeout": 10,
        "loop_limit": 1
      }
    ]
  }
}
